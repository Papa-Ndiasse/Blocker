<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Query installed browsers and known proxy-bypass apps to apply Device Owner policies -->
    <queries>
        <package android:name="com.android.chrome" />
        <package android:name="com.chrome.beta" />
        <package android:name="com.chrome.dev" />
        <package android:name="com.chrome.canary" />
        <package android:name="com.microsoft.emmx" />
        <package android:name="com.brave.browser" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="org.mozilla.firefox_beta" />
        <package android:name="org.mozilla.focus" />
        <package android:name="com.vivaldi.browser" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="org.torproject.torbrowser" />
        <package android:name="org.torproject.android" />
        <package android:name="com.opera.browser" />
        <package android:name="com.opera.mini.native" />
        <package android:name="com.opera.gx" />
        <package android:name="com.alohamobile.browser" />
        <package android:name="com.cloudmosa.puffinFree" />
        <package android:name="com.cloudmosa.puffin" />
        <package android:name="com.UCMobile.intl" />
        <package android:name="com.duckduckgo.mobile.android" />
    </queries>

    <application
        android:name=".BlockerApp"
        android:allowBackup="false"
        android:directBootAware="true"
        android:icon="@drawable/ic_launcher_shield"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@drawable/ic_launcher_shield"
        android:supportsRtl="true"
        android:theme="@style/Theme.Blocker">

        <activity
            android:name=".MainActivity"
            android:directBootAware="true"
            android:exported="true"
            android:theme="@style/Theme.Blocker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.BlockedActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Blocker" />

        <!-- Real-Time On-Screen & In-App Content Guard (Reddit, X, Browsers, Social Apps, Anti-Tamper) -->
        <service
            android:name=".guard.BlockerAccessibilityService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Device Owner Admin Receiver -->
        <receiver
            android:name=".admin.BlockerDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Boot & Direct-Boot Auto-Start Receiver -->
        <receiver
            android:name=".boot.BootCompletedReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Package Install Receiver: re-applies browser policies & suspends proxy-bypass browsers -->
        <receiver
            android:name=".admin.PackageInstallReceiver"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Receives silent uninstall results when Device Owner purges Tor / Mihon 18+ apps -->
        <receiver
            android:name=".admin.UninstallResultReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Receives silent self-update installation status from GitHubAutoUpdater -->
        <receiver
            android:name=".updater.InstallResultReceiver"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Always-On Local DNS Filtering VPN Service -->
        <service
            android:name=".vpn.BlockerVpnService"
            android:directBootAware="true"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="true" />
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local DNS adult-content firewall and SafeSearch enforcer" />
        </service>

    </application>

</manifest>
